rules_version = '2';

// ===============================================================
// Assumed Data Model — Las Malvinas Arcade
// ===============================================================
//
// Collection: ranking_publico
// Document ID: Auto-generated ID (matching ranking_privado/{entryId})
// Purpose: Public leaderboard (Top 10 Salón de la Fama). Contains ONLY username & score (NO contact/PII).
// Fields:
//   - name: string (required, 1..24 chars) - Player display name / nickname
//   - score: int (required, 0..50000) - Player arcade score
//   - verified: bool (required, must equal score <= 15000) - Anti-cheat verification flag
//   - uid: string (required, 1..128 chars, == request.auth.uid) - Submitter Auth UID
//   - createdAt: timestamp (required, == request.time) - Server submission timestamp
//
// Collection: ranking_privado
// Document ID: Same ID as ranking_publico/{entryId}
// Purpose: Admin-only raffle database with full WhatsApp / Instagram contact (PII).
// Fields:
//   - name: string (required, 1..24 chars) - Player display name / nickname
//   - contact: string (required, 2..40 chars) - Full WhatsApp number or Instagram handle
//   - score: int (required, 0..50000) - Player arcade score
//   - verified: bool (required, must equal score <= 15000) - Anti-cheat verification flag
//   - uid: string (required, 1..128 chars, == request.auth.uid) - Submitter Auth UID
//   - createdAt: timestamp (required, == request.time) - Server submission timestamp
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request has a valid Firebase Auth session (anonymous or admin)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the caller is the authenticated Heladería Las Malvinas administrator
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'admin@lasmalvinasarcade.web.app';
    }

    // Verify UID matches the authenticated user on create
    function uidUnchanged() {
      return 'uid' in request.resource.data
        && request.resource.data.uid is string
        && request.resource.data.uid.size() >= 1
        && request.resource.data.uid.size() <= 128
        && request.resource.data.uid == request.auth.uid;
    }

    // Ensure exact schema: required fields exist and no extraneous fields are allowed
    function hasExactFields(fields) {
      return request.resource.data.keys().hasAll(fields)
        && request.resource.data.keys().hasOnly(fields);
    }

    // Validate bounded non-empty string field
    function isValidBoundedString(val, minLen, maxLen) {
      return val is string
        && val.size() >= minLen
        && val.size() <= maxLen;
    }

    // Validate integer score range and consistent anti-cheat flag
    function isValidScoreAndVerification(data) {
      return data.score is int
        && data.score >= 0
        && data.score <= 50000
        && data.verified is bool
        && data.verified == (data.score <= 15000);
    }

    // Validate server-assigned creation timestamp
    function isServerTimestamp(val) {
      return val is timestamp && val == request.time;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidPublicEntry(data) {
      return hasExactFields(['name', 'score', 'verified', 'uid', 'createdAt'])
        && isValidBoundedString(data.name, 1, 24)
        && isValidScoreAndVerification(data)
        && isServerTimestamp(data.createdAt);
    }

    function isValidPrivateEntry(data) {
      return hasExactFields(['name', 'contact', 'score', 'verified', 'uid', 'createdAt'])
        && isValidBoundedString(data.name, 1, 24)
        && isValidBoundedString(data.contact, 2, 40)
        && isValidScoreAndVerification(data)
        && isServerTimestamp(data.createdAt);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Public leaderboard (NO raw PII)
    match /ranking_publico/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && uidUnchanged()
        && isValidPublicEntry(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Private raffle contact records (PII — strictly Admin read/delete only)
    match /ranking_privado/{entryId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && uidUnchanged()
        && isValidPrivateEntry(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Default deny for any other collection or subcollection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
